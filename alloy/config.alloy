logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "monitoring_test" {
  targets = [
    {
      __path__     = "/var/log/matchwise/monitoring-test.log",
      job          = "monitoring_test",
      service_name = "matchwise_test",
    },
  ]

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}


// Local RFC5424 syslog test receiver.
// Do not expose this port publicly.
loki.source.syslog "render_local_test" {
  listener {
    address = "127.0.0.1:1514"
    protocol = "tcp"
    labels = {
      job = "render_syslog_test",
      source = "local_test",
    }
  }

  forward_to = [loki.write.local.receiver]
}

// MatchWise TLS syslog receiver.
// Local-only during initial testing.
// Do not expose publicly without access restrictions.
loki.source.syslog "render_tls_test" {
  listener {
    address  = "127.0.0.1:6514"
    protocol = "tcp"

    labels = {
      job    = "render_tls_test",
      source = "tls_local_test",
    }

    tls_config {
      cert_file   = "/etc/alloy/tls/fullchain.pem"
      key_file    = "/etc/alloy/tls/privkey.pem"
      min_version = "TLS12"
    }
  }

  forward_to = [loki.write.local.receiver]
}
