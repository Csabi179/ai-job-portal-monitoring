logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "monitoring_test" {
  targets = [
    {
      __path__     = "/var/log/matchwise/monitoring-test.log",
      job          = "monitoring_test",
      service_name = "matchwise_test",
    },
  ]

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}


// Local RFC5424 syslog test receiver.
// Do not expose this port publicly.
loki.source.syslog "render_local_test" {
  listener {
    address = "127.0.0.1:1514"
    protocol = "tcp"
    labels = {
      job = "render_syslog_test",
      source = "local_test",
    }
  }

  forward_to = [loki.write.local.receiver]
}
