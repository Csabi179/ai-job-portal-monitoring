logging {
  level  = "info"
  format = "logfmt"
}

// Browser request details are separate from aggregate Prometheus metrics.
// Keep only the active file: archived files must not be re-ingested after rotation.
// Reception timestamps avoid trusting client wall clocks for Loki ordering.
local.file_match "frontend_requests" {
  sync_period = "10s"
  path_targets = [
    {
      __path__ = "/var/log/matchwise-frontend/requests.jsonl",
      job = "matchwise_frontend_requests",
      service_name = "matchwise-frontend",
    },
  ]
}

loki.source.file "frontend_requests" {
  targets = local.file_match.frontend_requests.targets
  forward_to = [loki.write.local.receiver]
}

loki.source.file "monitoring_test" {
  targets = [
    {
      __path__     = "/var/log/matchwise/monitoring-test.log",
      job          = "monitoring_test",
      service_name = "matchwise_test",
    },
  ]

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}


// Local RFC5424 syslog test receiver.
// Do not expose this port publicly.
loki.source.syslog "render_local_test" {
  listener {
    address = "127.0.0.1:1514"
    protocol = "tcp"
    labels = {
      job = "render_syslog_test",
      source = "local_test",
    }
  }

  forward_to = [loki.write.local.receiver]
}

// MatchWise TLS syslog receiver.
// Local-only during initial testing.
// Do not expose publicly without access restrictions.
loki.source.syslog "render_tls_test" {
  listener {
    address  = "127.0.0.1:6514"
    protocol = "tcp"

    labels = {
      job    = "render_tls_test",
      source = "tls_local_test",
    }

    tls_config {
      cert_file   = "/etc/alloy/tls/fullchain.pem"
      key_file    = "/etc/alloy/tls/privkey.pem"
      min_version = "TLS12"
    }
  }

  forward_to = [loki.write.local.receiver]
}


// MatchWise backend logs retrieved securely from Render API.
loki.source.file "render_backend_api" {
  targets = [
    {
      __path__     = "/var/log/matchwise/render-backend.jsonl",
      job          = "matchwise_backend_render_api",
      service_name = "job-portal-backend",
      source       = "render_logs_api",
    },
  ]

  forward_to = [loki.process.render_backend_timestamp.receiver]
}


// Use original Render event timestamps in Loki.
loki.process "render_backend_timestamp" {
  stage.json {
    expressions = {
      event_time = "renderTimestamp",
    }
  }

  stage.timestamp {
    source = "event_time"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }

  forward_to = [loki.write.local.receiver]
}
