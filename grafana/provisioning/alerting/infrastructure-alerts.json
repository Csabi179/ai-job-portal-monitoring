{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "infrastructure-monitoring",
      "folder": "AI Job Portal",
      "interval": "1m",
      "rules": [
        {
          "uid": "ai_job_low_memory",
          "title": "Oracle - Low Available Memory",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "100 * node_memory_MemAvailable_bytes{job=\"node_exporter\"} / node_memory_MemTotal_bytes{job=\"node_exporter\"}",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        10
                      ],
                      "type": "lt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "10m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "Oracle available RAM is below 10%",
            "description": "Available system memory has been below 10% for 10 minutes."
          },
          "labels": {
            "severity": "warning",
            "component": "oracle_infrastructure"
          },
          "isPaused": false
        },
        {
          "uid": "ai_job_low_disk",
          "title": "Oracle - Low Disk Space",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "100 * node_filesystem_avail_bytes{job=\"node_exporter\",mountpoint=\"/\",fstype=\"ext4\"} / node_filesystem_size_bytes{job=\"node_exporter\",mountpoint=\"/\",fstype=\"ext4\"}",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        15
                      ],
                      "type": "lt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "10m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "Oracle root filesystem has less than 15% free space",
            "description": "Available space on the root filesystem has been below 15% for 10 minutes."
          },
          "labels": {
            "severity": "warning",
            "component": "oracle_infrastructure"
          },
          "isPaused": false
        },
        {
          "uid": "ai_job_exporter_down",
          "title": "Oracle - Exporter DOWN",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "1 - up{job=~\"node_exporter|blackbox_exporter\"}",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "3m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "Monitoring exporter is unavailable",
            "description": "One of the monitoring exporters has been unreachable for 3 minutes."
          },
          "labels": {
            "severity": "warning",
            "component": "oracle_infrastructure"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
