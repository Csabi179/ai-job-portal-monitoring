          ],
          "for": "2m",
          "noDataState": "KeepLast",
          "execErrState": "KeepLast",
          "annotations": {
            "summary": "MatchWise | Render backend | Rejected login burst",
            "description": "At least 10 logged POST login HTTP 401 responses in a rolling 5-minute window, sustained for 2 minutes. This is a signal to investigate, not proof of an attack.",
            "runbook_url": "https://github.com/Csabi179/ai-job-portal-monitoring/blob/feat/service-comparison/docs/SERVICE_COMPARISON_ALERTS.md"
          },
          "labels": {
            "project": "matchwise",
            "environment": "university",
            "severity": "warning",
            "component": "matchwise_backend",
            "category": "security"
          },
          "isPaused": false
        },
