{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "render-backend-monitoring",
      "folder": "AI Job Portal",
      "interval": "1m",
      "rules": [
        {
          "uid": "matchwise_backend_down",
          "title": "MatchWise | Render backend | HTTP-kiesés",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "max(1 - last_over_time(probe_success{job=\"blackbox_render_backend\",service=\"matchwise_backend\"}[40m])) and (min(last_over_time(up{job=\"blackbox_render_backend\",service=\"matchwise_backend\"}[40m])) == 1)",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "2m",
          "noDataState": "KeepLast",
          "execErrState": "KeepLast",
          "annotations": {
            "summary": "MatchWise | Render backend | HTTP-kiesés",
            "description": "A legutóbbi, 40m-en belüli sikeres scrape HTTP-próbája nem kapott elfogadott 200 választ. A mérés sikeressége és a HTTP-próba eredménye eltérő. Helyreállás csak új sikeres HTTP-próba alapján; hiányzó mérésnél az előző állapot megmarad.",
            "runbook_url": "https://github.com/Csabi179/ai-job-portal-monitoring/blob/main/docs/alerting-plan.md#http"
          },
          "labels": {
            "project": "matchwise",
            "environment": "university",
            "severity": "critical",
            "component": "matchwise_backend",
            "category": "availability"
          },
          "isPaused": false
        },
        {
          "uid": "matchwise_backend_probe_missing",
          "title": "MatchWise | Render backend | Megfigyelési hiba",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "1 - (min(last_over_time(up{job=\"blackbox_render_backend\",service=\"matchwise_backend\"}[40m])) or vector(0)) * (max(present_over_time(probe_success{job=\"blackbox_render_backend\",service=\"matchwise_backend\"}[40m])) or vector(0))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "2m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "annotations": {
            "summary": "MatchWise | Render backend | Megfigyelési hiba",
            "description": "A legutóbbi up=0, vagy 40m-e nincs up/probe_success mérés. Ez nem bizonyít alkalmazáskiesést. A frissességi ablakon belüli eredmény a legutóbbi mintavételre vonatkozik.",
            "runbook_url": "https://github.com/Csabi179/ai-job-portal-monitoring/blob/main/docs/alerting-plan.md#http"
          },
          "labels": {
            "project": "matchwise",
            "environment": "university",
            "severity": "critical",
            "component": "matchwise_backend",
            "category": "monitoring"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
