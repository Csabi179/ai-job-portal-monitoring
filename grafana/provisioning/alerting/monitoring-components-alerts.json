{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "monitoring-components",
      "folder": "AI Job Portal",
      "interval": "1m",
      "rules": [
        {
          "uid": "matchwise_loki_health_unavailable",
          "title": "MatchWise | Loki | Health check failure",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "1 - (min(probe_success{job=\"blackbox_monitoring_components\",service=\"loki\"}) or vector(0)) * (min(up{job=\"blackbox_monitoring_components\",service=\"loki\"}) or vector(0))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "3m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "annotations": {
            "summary": "MatchWise | Loki | Health check failure",
            "description": "Loki /ready did not return HTTP 200, or its probe scrape failed/is missing. Check Blackbox Exporter too. A healthy endpoint does not prove end-to-end log delivery.",
            "runbook_url": "https://github.com/Csabi179/ai-job-portal-monitoring/blob/main/docs/alerting-plan.en.md#logs"
          },
          "labels": {
            "project": "matchwise",
            "environment": "university",
            "severity": "critical",
            "component": "loki",
            "category": "monitoring"
          },
          "isPaused": false
        },
        {
          "uid": "matchwise_alloy_health_unavailable",
          "title": "MatchWise | Alloy | Health check failure",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "1 - (min(probe_success{job=\"blackbox_monitoring_components\",service=\"alloy\"}) or vector(0)) * (min(up{job=\"blackbox_monitoring_components\",service=\"alloy\"}) or vector(0))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "3m",
          "noDataState": "Alerting",
          "execErrState": "Error",
          "annotations": {
            "summary": "MatchWise | Alloy | Health check failure",
            "description": "Alloy /-/healthy did not return HTTP 200, or its probe scrape failed/is missing. Check Blackbox Exporter too. A healthy endpoint does not prove end-to-end log delivery.",
            "runbook_url": "https://github.com/Csabi179/ai-job-portal-monitoring/blob/main/docs/alerting-plan.en.md#logs"
          },
          "labels": {
            "project": "matchwise",
            "environment": "university",
            "severity": "critical",
            "component": "alloy",
            "category": "monitoring"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
