{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "render-log-collector-monitoring",
      "folder": "AI Job Portal",
      "interval": "1m",
      "rules": [
        {
          "uid": "matchwise_render_collector_stale",
          "title": "MatchWise | Render log collector | Monitoring failure",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "clamp_max((max((time() - matchwise_render_collector_last_success_timestamp_seconds{job=\"node_exporter\"}) > bool 300) or vector(1)) + (max(node_textfile_scrape_error{job=\"node_exporter\"}) or vector(1)), 1) and (min(up{job=\"node_exporter\"}) == 1)",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "reducer": "last",
                "type": "reduce",
                "refId": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "type": "threshold",
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        0.5
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "refId": "C",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ],
          "for": "2m",
          "noDataState": "KeepLast",
          "execErrState": "KeepLast",
          "annotations": {
            "summary": "MatchWise | Render log collector | Monitoring failure",
            "description": "Collector success is over 300s old, heartbeat/textfile status is missing, or textfile processing failed. Requires Node Exporter to be up. A quiet application is not a fault.",
            "runbook_url": "https://github.com/Csabi179/ai-job-portal-monitoring/blob/main/docs/alerting-plan.en.md#collector"
          },
          "labels": {
            "project": "matchwise",
            "environment": "university",
            "severity": "critical",
            "component": "render_log_collector",
            "category": "monitoring"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
