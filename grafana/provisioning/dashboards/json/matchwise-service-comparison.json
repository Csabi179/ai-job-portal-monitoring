{
  "uid": "matchwise-service-comparison",
  "title": "MatchWise · Service Comparison",
  "schemaVersion": 42,
  "version": 1,
  "editable": false,
  "tags": [
    "matchwise",
    "security",
    "comparison"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "supabase_instance",
        "type": "query",
        "label": "Supabase target",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(up{job=\"supabase\"})",
          "refId": "StandardVariableQuery"
        },
        "definition": "query_result(up{job=\"supabase\"})",
        "regex": "/instance=\"([^\"]+)\"/",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": "uvopvarvelpabhmrqaaw.supabase.co:443",
          "value": "uvopvarvelpabhmrqaaw.supabase.co:443"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "MatchWise · Service Comparison",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Compare changes at the same time. Percentages use each service's own capacity; machines have different sizes. CPU: Oracle/Supabase use a 5-minute average; Render uses API samples. Gaps mean missing or stale data. Different usage alone does not prove an attack."
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "Backend · Render",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Render API resources + HTTP probes."
      }
    },
    {
      "id": 3,
      "type": "text",
      "title": "Database · Supabase",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Database host resources + Metrics API."
      }
    },
    {
      "id": 4,
