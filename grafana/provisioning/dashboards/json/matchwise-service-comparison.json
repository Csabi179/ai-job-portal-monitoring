    {
      "id": 10,
      "type": "timeseries",
      "title": "Backend · CPU (%)",
      "description": "Render API usage / CPU limit. Hidden if collection fails, source is older than five minutes, attempt older than four minutes or Node Exporter has errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(matchwise_render_cpu_utilization_percent{job=\"node_exporter\",service=\"matchwise_backend\"}) and ((matchwise_render_metrics_collection_success{job=\"node_exporter\",service=\"matchwise_backend\"} == 1) and (time() - matchwise_render_metrics_last_attempt_timestamp_seconds{job=\"node_exporter\",service=\"matchwise_backend\"} < 240) and (time() - matchwise_render_metrics_source_timestamp_seconds{job=\"node_exporter\",service=\"matchwise_backend\"} < 300) and on(job,instance) (up{job=\"node_exporter\"} == 1) and on(job,instance) (node_textfile_scrape_error{job=\"node_exporter\"} == 0))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Backend · CPU (%)",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "max": 100,
          "noValue": "No fresh data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.1",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 6
