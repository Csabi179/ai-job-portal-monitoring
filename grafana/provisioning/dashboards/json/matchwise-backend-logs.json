          "editorMode": "code",
          "expr": "topk(\r\n  10,\r\n  sum by (route) (\r\n    count_over_time(\r\n      {job=\"matchwise_backend_render_api\"}\r\n      | json route=\"route\"\r\n      | route != \"\"\r\n      | __error__=\"\" [$__range]\r\n    )\r\n  )\r\n)",
          "legendFormat": "{{route}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Leggyakoribb route-ok",
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "route",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "Value #A",
                "handlerKey": "field.value"
              },
              {
                "fieldName": "Time",
                "handlerKey": "__ignore"
              }
            ]
          }
        }
      ],
      "type": "bargauge"
