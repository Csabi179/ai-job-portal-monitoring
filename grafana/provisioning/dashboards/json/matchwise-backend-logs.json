          "editorMode": "code",
          "expr": "quantile_over_time(\r\n  0.50,\r\n  {job=\"matchwise_backend_render_api\"}\r\n  | json duration_ms=\"responseTimeMs\"\r\n  | unwrap duration_ms\r\n  | __error__=\"\" [15m]\r\n) by (job)",
