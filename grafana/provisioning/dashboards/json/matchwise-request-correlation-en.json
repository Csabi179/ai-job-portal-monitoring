{
  "uid": "matchwise-request-correlation-en",
  "title": "MatchWise · Request Correlation",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "matchwise",
    "request-correlation",
    "en"
  ],
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Frontend and backend requests",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Match: frontend `request_id` = backend `reqId`.** The top table compares timings by the shared ID. Frontend measures fetch until response headers; backend measures server processing. Their difference is not pure network time. A missing match is not zero latency. ID-less failures appear separately below. UptimeRobot/health checks are excluded; the table only retains requests reported by the frontend. Real mode only; browser reports are untrusted. Maximum 1000 log lines per side/query: narrow the time range or enter an ID. Collection times differ: refresh or widen the time range for delayed backend matches."
      },
      "targets": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Timing and status per request",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 12
      },
      "description": "Outer join by ID. Empty frontend/backend cells mean no match in the selected window. Records without IDs are never joined to each other.",
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "frontend_ms (lastNotNull)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 1000,
                      "color": "orange"
                    },
                    {
                      "value": 5000,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backend_ms (lastNotNull)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 1000,
                      "color": "orange"
                    },
                    {
                      "value": 5000,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "frontend_started_ms (lastNotNull)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"matchwise_frontend_requests\"} | json | event=\"frontend_request\" | mode=\"real\" | route!~\"/(api/)?health/?\" | __error__=\"\" | request_id=~\"[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\" | request_id=~\".*${request_id:regex}.*\" | line_format `{\"request_id\":{{ printf \"%q\" .request_id }},\"frontend_ms\":{{.duration_ms}},\"frontend_route\":{{ printf \"%q\" .route }},\"frontend_status\":{{ printf \"%q\" .status }},\"frontend_outcome\":{{ printf \"%q\" .outcome }},\"frontend_started_ms\":{{.started_at_ms}}}`",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 1000
        },
        {
          "refId": "B",
          "expr": "{job=\"matchwise_backend_render_api\"} | json | event=\"http_request\" | route!~\"/(api/)?health/?\" | __error__=\"\" | reqId=~\"[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\" | reqId=~\".*${request_id:regex}.*\" | responseTimeMs >= 0 | __error__=\"\" | line_format `{\"request_id\":{{ printf \"%q\" .reqId }},\"backend_ms\":{{.responseTimeMs}},\"backend_route\":{{ printf \"%q\" .route }},\"backend_status\":{{ printf \"%q\" .statusCode }}}`",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "transformations": [
        {
          "id": "extractFields",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "groupBy",
          "filter": {
            "id": "byRefId",
            "options": "A"
          },
          "options": {
            "fields": {
              "request_id": {
                "operation": "groupby",
                "aggregations": []
              },
              "frontend_ms": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              },
              "frontend_route": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              },
              "frontend_status": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              },
              "frontend_outcome": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              },
              "frontend_started_ms": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              }
            }
          }
        },
        {
          "id": "extractFields",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": false
          }
        },
        {
          "id": "groupBy",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {
            "fields": {
              "request_id": {
                "operation": "groupby",
                "aggregations": []
              },
              "backend_ms": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              },
              "backend_route": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              },
              "backend_status": {
                "operation": "aggregate",
                "aggregations": [
                  "lastNotNull"
                ]
              }
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "request_id",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "frontend_route (lastNotNull)",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "frontend_ms (lastNotNull)",
                "destinationType": "number"
              },
              {
                "targetField": "backend_ms (lastNotNull)",
                "destinationType": "number"
              },
              {
                "targetField": "frontend_started_ms (lastNotNull)",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "frontend_ms (lastNotNull)",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "frontend_ms (lastNotNull)": "frontend_ms",
              "frontend_route (lastNotNull)": "frontend_route",
              "frontend_status (lastNotNull)": "frontend_status",
              "frontend_outcome (lastNotNull)": "frontend_outcome",
              "frontend_started_ms (lastNotNull)": "frontend_started_ms",
              "backend_ms (lastNotNull)": "backend_ms",
              "backend_route (lastNotNull)": "backend_route",
              "backend_status (lastNotNull)": "backend_status"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Slow or failed frontend requests",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "description": "Slow threshold in ms; 4xx/5xx, network errors and aborts. Retains records without IDs.",
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"matchwise_frontend_requests\"} | json | event=\"frontend_request\" | mode=\"real\" | route!~\"/(api/)?health/?\" | __error__=\"\" | duration_ms >= ${slow_ms:raw} or status=~\"[45][0-9][0-9]\" or outcome!=\"http\" | __error__=\"\" | request_id=~\".*${request_id:regex}.*\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Frontend requests without a backend ID",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "description": "Includes HTTP responses without an exposed/preserved ID, not only network failures.",
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "showLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"matchwise_frontend_requests\"} | json | event=\"frontend_request\" | mode=\"real\" | route!~\"/(api/)?health/?\" | __error__=\"\" | request_id=\"\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Received request details",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 8,
        "h": 4
      },
      "description": "Estimated counter increase over the selected range; not a count of matched requests.",
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(frontend_telemetry_request_records_total{job=\"frontend_traffic\",mode=\"real\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Received details without ID",
      "gridPos": {
        "x": 8,
        "y": 34,
        "w": 8,
        "h": 4
      },
      "description": "Estimated counter increase over the selected range; not a count of matched requests.",
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(frontend_telemetry_request_records_without_id_total{job=\"frontend_traffic\",mode=\"real\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Details dropped by frontend",
      "gridPos": {
        "x": 16,
        "y": 34,
        "w": 8,
        "h": 4
      },
      "description": "Estimated counter increase over the selected range; not a count of matched requests.",
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
