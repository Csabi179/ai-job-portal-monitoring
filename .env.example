# Grafana administrator password
# Generate a strong password before first deployment.
# Never commit the real .env file.

GRAFANA_ADMIN_PASSWORD=

# Telegram alert notifications
# Create a bot with @BotFather and obtain the target Chat ID.
GRAFANA_TELEGRAM_BOT_TOKEN=
GRAFANA_TELEGRAM_CHAT_ID=

# Supabase metrics and backend configuration reference
# Keep these values in the local .env. Run the preparation script after changes.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Backend reference values; configure the Render service separately.
CLIENT_ORIGIN=https://www.matchwise.tech
NODE_ENV=production
PORT=10000
